# ==============================================================================
# YATRA - Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env for local development:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# 2. Never commit actual secret keys or credentials to version control.
# 3. YATRA defaults to open-source OpenStreetMap and MapLibre GL JS tiles to avoid
#    requiring paid mapping keys for basic development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=YATRA
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Database & Cache (Local Docker Compose or Native PostgreSQL/Redis)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with PostGIS enabled.
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/yatra_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yatra_dev

# Synchronous fallback connection URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yatra_dev

# Redis URL for pub/sub, caching, and real-time handshake events
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used to sign JWT tokens for Passenger, Driver, and Operator authentication
# Generate a strong 256-bit key: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API
# ------------------------------------------------------------------------------
# Official Google Gen AI SDK key for multilingual accessibility interpretation,
# structured incident categorization, and audio announcement generation.
# Obtain a free development key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Maps & Geocoding (Free-first OpenStreetMap / MapLibre architecture)
# ------------------------------------------------------------------------------
# MapLibre style JSON URL (Defaults to free vector tiles e.g. OpenStreetMap / Protomaps / Demotiles)
MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json

# Optional: Google Maps API key (ONLY needed if evaluating Google transit APIs)
# Left empty by default to prevent unexpected billing.
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Blockchain: Trust Ledger (Ethereum Sepolia Testnet)
# ------------------------------------------------------------------------------
# Sepolia RPC endpoint (Alchemy, Infura, or public RPC e.g. https://rpc.sepolia.org)
ETHEREUM_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Testnet deployment private key (DO NOT use a mainnet key or wallet with real funds)
ETHEREUM_PRIVATE_KEY=your_sepolia_private_key_without_0x_prefix

# Deployed TrustLedger contract address on Sepolia (populated after running deployment script)
TRUST_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# Delhi Transit Stack / Open Data Paths
# ------------------------------------------------------------------------------
DATA_DIR=./data
GTFS_DIR=./data/gtfs
GPS_DIR=./data/gps
TICKETING_DIR=./data/ticketing
SAMPLE_DIR=./data/sample

